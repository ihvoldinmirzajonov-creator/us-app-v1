rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Couple media stored under couples/{coupleId}/...
    match /couples/{coupleId}/{allPaths=**} {
      allow read, write: if request.auth != null && isCoupleMember(coupleId);
    }

    // Public assets
    match /public/{allPaths=**} {
      allow read;
    }

    function isCoupleMember(coupleId) {
      return exists(/databases/(default)/documents/couples/$(coupleId))
        && (get(/databases/(default)/documents/couples/$(coupleId)).data.partnerAId == request.auth.uid
            || get(/databases/(default)/documents/couples/$(coupleId)).data.partnerBId == request.auth.uid);
    }
  }
}
